<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nexus-Vibe logging.

  Console output stays on in every profile so `docker logs` keeps working. Prod adds a
  structured JSON file on a rolling policy (see logback/prod-file-appender.xml), because a
  rebuilt container otherwise loses every log line the self-healing paths emitted.

  The prod appenders live in an included fragment holding no Spring-specific tags, so a unit test
  can parse the real production graph through plain logback instead of trusting a copy of it.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- The brackets stay when traceId is unset so grepping by column keeps working. -->
    <property name="NEXUS_CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{traceId:-}]){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${NEXUS_CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <springProfile name="prod">
        <include resource="logback/prod-file-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
