# Copy to .env and fill in real values.
# docker compose reads this file automatically.

# ---- Server ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ---- MySQL (service name is db inside the compose network) ----
DB_URL=jdbc:mysql://db:3306/nexus_campus?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# ---- Redis ----
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Elasticsearch ----
ES_URI=http://elasticsearch:9200

# ---- Cache ----
CACHE_TTL=1h

# ---- Demo / bootstrap accounts ----
# DataPreloader creates the admin/test accounts at startup with this password.
# Required in production; leave empty to fail fast instead of seeding a known default.
DEMO_PASSWORD=

# ---- LLM (OpenAI-compatible chat completions API) ----
# Dev default (application.yml) targets local Ollama at http://localhost:11434/v1
# with model qwen2.5:7b. For production, point LLM_ENDPOINT at any
# OpenAI-compatible API and fill LLM_API_KEY.
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT=30s

# ---- JWT ----
# Generate a 32+ byte secret: openssl rand -base64 32
# Leave empty in .env to fail fast in production instead of using a weak default.
JWT_SECRET=

# ---- Uploads ----
UPLOAD_DIR=/app/uploads
