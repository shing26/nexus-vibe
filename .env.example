# Copy to .env and fill in real values.
# docker compose reads this file automatically.

# ---- Server ----
WEB_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ---- MySQL (service name is db inside the compose network) ----
DB_URL=jdbc:mysql://db:3306/nexus_campus?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Browser origins allowed to call the API. Include the local Docker URL
# (http://localhost:8080) for local full-stack verification.
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://nexus-vibe.shing26.is-a.dev

# ---- Redis ----
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Elasticsearch ----
ES_URI=http://elasticsearch:9200

# ---- Cache ----
CACHE_TTL=1h

# ---- Demo / bootstrap accounts ----
# With seeding off (the production default) the database holds no demo accounts and no
# sample posts at all; only the functional AiAgent(999) row is created. Set to true and
# fill DEMO_PASSWORD only if you intentionally want a public demo login.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
# The one administrator for a deployment with seeding off. BootstrapAdminInitializer
# creates 'admin' from this once, when the database has no ADMIN yet, and warns you to
# rotate it. Leave blank and the app still serves traffic — it simply has no admin area.
# Changing or deleting this value later does not touch the account: the row is yours
# after the first start.
BOOTSTRAP_ADMIN_PASSWORD=
# Feature-demo endpoints (/api/demo/*): seed posts, like bursts. Anonymous by
# design — keep false in production, true only for a throwaway demo instance.
DEMO_ENDPOINTS_ENABLED=false

# ---- LLM (OpenAI-compatible chat completions API) ----
# Compose-internal Ollama by default. Pull the model once:
#   docker compose exec ollama ollama pull qwen2.5:3b   # CPU 机器推荐
#   docker compose exec ollama ollama pull qwen2.5:7b   # 算力充足时
# 质量门槛：本地 7B/3B 模型通常无法产出有实质内容的评审（会被语义校验判为
# unknown 静默降级，不出评分）。生产建议托管模型（如 gpt-4o）或本地 >=14B。
LLM_ENDPOINT=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=30s

# ---- JWT ----
# Generate a 32+ byte secret: openssl rand -base64 32
# Required in production; the app fails fast when this is blank.
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---- Uploads ----
UPLOAD_DIR=/app/uploads

# ---- Monitoring profile (docker compose --profile monitoring up) ----
# Nothing here is read unless the monitoring profile is on. No dashboard maps a host
# port; reach them from inside nexus-net.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Custom bot in the on-call Feishu group: webhook URL plus the signing secret
# (安全设置 -> 加签). The alert-bridge signs each request with the secret; leave both
# blank to drill without Feishu delivery — the bridge then fails the alert loudly
# instead of dropping it.
FEISHU_ALERT_WEBHOOK=
FEISHU_ALERT_SECRET=
