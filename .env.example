# Copy to .env and fill in real values.
# docker compose reads this file automatically.

# ---- Server ----
WEB_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ---- Release tag ----
# APP_TAG is the release identity stamped on both application images:
#   nexus-vibe-app:${APP_TAG}   nexus-vibe-web:${APP_TAG}
# It is required on purpose: docker compose config refuses to resolve without it, because an
# anonymous build leaves nothing to point at and nowhere to roll back to.
# Use a value that identifies exactly one build and never gets reused (git short sha, or
# 20260914-01). dev is fine for local iteration but it is a moving target; do not release it.
#   Release:  edit APP_TAG below, then   docker compose up -d --build app web
#   Rollback: docker compose up -d --no-build app web
#             with APP_TAG set back to the previous value (prefix the command with
#             APP_TAG=<previous> for a one-shot rollback, then write that value into this
#             file so the next up does not drift forward again). No --build: the previous
#             tag's image is still on the host, and reusing it is the whole point.
# Keep at least the last two tags' images. Never run docker image prune -a or
# docker compose down --rmi all against this project; those delete the rollback target.
APP_TAG=dev

# ---- MySQL (service name is db inside the compose network) ----
DB_URL=jdbc:mysql://db:3306/nexus_campus?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Browser origins allowed to call the API. Include the local Docker URL
# (http://localhost:8080) for local full-stack verification.
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://nexus-vibe.shing26.is-a.dev

# ---- Redis ----
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Elasticsearch ----
ES_URI=http://elasticsearch:9200

# ---- Cache ----
CACHE_TTL=1h

# ---- Demo / bootstrap accounts ----
# With seeding off (the production default) the database holds no demo accounts and no
# sample posts at all; only the functional AiAgent(999) row is created. Set to true and
# fill DEMO_PASSWORD only if you intentionally want a public demo login.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
# The one administrator for a deployment with seeding off. BootstrapAdminInitializer
# creates 'admin' from this once, when the database has no ADMIN yet, and warns you to
# rotate it. Leave blank and the app still serves traffic — it simply has no admin area.
# Changing or deleting this value later does not touch the account: the row is yours
# after the first start.
BOOTSTRAP_ADMIN_PASSWORD=
# Feature-demo endpoints (/api/demo/*): seed posts, like bursts. Anonymous by
# design — keep false in production, true only for a throwaway demo instance.
DEMO_ENDPOINTS_ENABLED=false
# A deployment whose demo seeding is OFF has no content for a visitor to look at, so the
# landing page can carry one already-reviewed post instead. Different switch, different
# meaning: it writes a single post by a real account, never sample users. Uncomment in a
# deployed instance (the author must already exist) and the landing-page entry appears.
#   SHOWCASE_POST_ID=900000000000000001
#   SHOWCASE_AUTHOR_USERNAME=admin

# ---- LLM (OpenAI-compatible chat completions API) ----
# Compose-internal Ollama by default. Pull the model once:
#   docker compose exec ollama ollama pull qwen2.5:3b   # CPU 机器推荐
#   docker compose exec ollama ollama pull qwen2.5:7b   # 算力充足时
# 质量门槛：本地 7B/3B 模型通常无法产出有实质内容的评审（会被语义校验判为
# unknown 静默降级，不出评分）。生产建议托管模型（如 gpt-4o）或本地 >=14B。
LLM_ENDPOINT=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=30s

# ---- JWT ----
# Generate a 32+ byte secret: openssl rand -base64 32
# Required in production; the app fails fast when this is blank.
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---- Uploads ----
UPLOAD_DIR=/app/uploads

# ---- Monitoring profile (docker compose --profile monitoring up) ----
# Nothing here is read unless the monitoring profile is on. No dashboard maps a host
# port; reach them from inside nexus-net.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Custom bot in the on-call Feishu group: webhook URL plus the signing secret
# (安全设置 -> 加签). The alert-bridge signs each request with the secret. Both blank is a
# supported state, but it is not a quiet one: the bridge refuses to start and names this
# variable, so `--profile monitoring` without a webhook shows up as a restarting container
# rather than a green dashboard. benchmark/observability/drill.ps1 supplies its own in-network
# sink instead, so the drill needs neither of these.
FEISHU_ALERT_WEBHOOK=
FEISHU_ALERT_SECRET=
