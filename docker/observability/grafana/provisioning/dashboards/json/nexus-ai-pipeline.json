{
  "uid": "nexus-ai-pipeline",
  "title": "Nexus-Vibe AI Pipeline",
  "description": "The self-healing AI review path: LLM calls, circuit breaker, review backlog, reconciliation repairs.",
  "tags": ["nexus-vibe", "ai"],
  "timezone": "Asia/Shanghai",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM circuit breaker",
      "description": "1 means the breaker is open and posts are parking in pending-llm.",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" }, "1": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "max(llm_circuit_breaker_open{application=\"nexus-vibe\"})",
          "legendFormat": "breaker"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM success rate",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_chat_completions_total{outcome=\"success\"}[10m])) / sum(rate(llm_chat_completions_total[10m]))",
          "legendFormat": "success"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reviews awaiting reconcile",
      "description": "ai_review_reconcile_repairs_total is the repair counter; ai_review_pending_posts is the backlog gauge.",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "ai_review_pending_posts{application=\"nexus-vibe\"}",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lease attempts exhausted",
      "description": "Posts that burned the whole attempt budget and went terminal without a verdict.",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_review_lease_attempts_exhausted_total[24h]))",
          "legendFormat": "last 24h"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM calls by outcome",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(llm_chat_completions_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM completion latency",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_chat_completion_duration_seconds_bucket[10m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_chat_completion_duration_seconds_bucket[10m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_chat_completion_duration_seconds_bucket[10m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Review backlog vs reconcile repairs",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "ai_review_pending_posts{application=\"nexus-vibe\"}",
          "legendFormat": "pending posts"
        },
        {
          "refId": "B",
          "expr": "sum by (kind) (increase(ai_review_reconcile_repairs_total[10m]))",
          "legendFormat": "repairs {{kind}}"
        }
      ]
    }
  ]
}
