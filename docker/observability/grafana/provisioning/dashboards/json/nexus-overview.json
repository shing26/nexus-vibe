{
  "uid": "nexus-overview",
  "title": "Nexus-Vibe Overview",
  "description": "Serving health: traffic, errors, latency, JVM. OS metrics only appear on a container JVM, so cpu load reads as No data under surefire with -XX:-UseContainerSupport.",
  "tags": ["nexus-vibe"],
  "timezone": "Asia/Shanghai",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx ratio",
      "description": "Drives the 5xx alert rule; keep this panel and the rule expression identical.",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Process uptime",
      "description": "A low value right after a deploy is fine; a low value with no deploy means a restart.",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "process_uptime_seconds{application=\"nexus-vibe\"}",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Containers up",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"nexus-vibe\"}",
          "legendFormat": "app"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by uri",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_count[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM heap",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"nexus-vibe\",area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{application=\"nexus-vibe\",area=\"heap\"})",
          "legendFormat": "committed"
        },
        {
          "refId": "C",
          "expr": "sum(jvm_memory_max_bytes{application=\"nexus-vibe\",area=\"heap\"})",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU load (container JVM only)",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{application=\"nexus-vibe\"}",
          "legendFormat": "process"
        },
        {
          "refId": "B",
          "expr": "system_cpu_usage{application=\"nexus-vibe\"}",
          "legendFormat": "system"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate limit rejections",
      "description": "Counter is registered in T3; the panel lands first so the alert rule has somewhere to live.",
      "datasource": { "type": "prometheus", "uid": "nexus-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(rate_limit_rejected_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ]
    }
  ]
}
