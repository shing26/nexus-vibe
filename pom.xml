<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.nexus</groupId>
    <artifactId>campus</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Nexus-Vibe</name>
    <description>AI-Powered Developer Community for Prompt Engineering, Code Gen, and AI Agents</description>

    <properties>
        <java.version>18</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <jjwt.version>0.12.6</jjwt.version>
        <elasticsearch.version>8.13.4</elasticsearch.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!--
          Declared empty on purpose, and it is not dead config.

          jacoco:prepare-agent writes the agent JVM arguments into this property, and the
          surefire <argLine> in the profile below reads it back with ${argLine}. Declaring it
          means the expression still resolves when JaCoCo is skipped (-Djacoco.skip=true, the
          memory-limited local run), instead of reaching the forked JVM as the literal text
          "${argLine}" and failing every test with "Unrecognized option".

          The flip side is the trap this declaration makes visible: passing -DargLine="..." on
          the command line replaces the agent arguments rather than appending to them, so the
          agent never loads and coverage silently measures 0.00, which then trips jacoco:check.
          Use -Djacoco.skip=true when you need to override the forked JVM's
          memory settings by hand.
        -->
        <argLine></argLine>
        <!--
          Line-coverage floor for the whole bundle. First measured run on 2026-09-21 was
          2967/3995 = 74.27% line coverage (target/site/jacoco/jacoco.xml, BUNDLE counter), so
          the floor is that value floored down to the nearest 5%: 0.70. It is a ratchet against
          "the suite grew and nothing exercises the new code", not a quality target - raise it
          when a real run clears the next 5% step with margin. See README's Testing section.
        -->
        <jacoco.line.minimum>0.70</jacoco.line.minimum>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus text format for /actuator/prometheus. Version comes from the Boot BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Jakarta Servlet API -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
       </dependency>
        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
       <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 (dev + test) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Elasticsearch -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elasticsearch.client</groupId>
            <artifactId>elasticsearch-rest-client</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logstash JSON encoder (8.x targets the logback 1.5 line that Boot 3.3 pulls in) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- HTML sanitization (whitelist-based XSS defense) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>nexus-campus</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.nexus.campus.NexusCampusApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      No cron clock inside @SpringBootTest. AiReviewReconcileTask fires on
                      wall-clock minutes and writes a five-minute LLM health verdict into a
                      shared cache; a sweep landing between two test methods used to fail every
                      later post closed, which is how a docs-only commit turned CI red.

                      This is a system property rather than the `test` profile on purpose: nothing
                      in the repository ever activates that profile (no @ActiveProfiles, no
                      spring.profiles.active), so src/test/resources/application-test.yml is dead
                      config, and switching it on now would also apply its ErrorMvcAutoConfiguration
                      exclude to every suite.
                    -->
                    <systemPropertyVariables>
                        <campus.scheduling.enabled>false</campus.scheduling.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
              One global floor rather than per-package gates: the failure mode this catches is
              "the suite grew and nothing exercises the new code", which a per-class threshold
              cannot see and which a single bundle ratio reports honestly.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-line-coverage</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
              Formerly id `ci-linux`, activated implicitly by an os family of `unix`. Two problems:
              the name claimed linux while macOS matched it too, and a build flag that switches
              itself on according to the operating system is invisible in CI logs. It was reported
              twice in review as "CI never uses this profile", which was wrong, and the wrongness
              was the point. It is now opt-in from the workflow that needs it
              (.github/workflows/maven.yml), so the flag is either visible in the command line or
              genuinely absent. It is a unix-only flag: measured on Windows, HotSpot rejects
              -XX:-UseContainerSupport outright ("Could not create the Java Virtual Machine", forked
              VM dies before a single test runs), so running this profile locally on Windows is an
              error, not a no-op. That asymmetry is the reason the old implicit activation existed,
              and it belongs in a comment rather than in a hidden condition.

              Coverage tooling landed here (jacoco-maven-plugin, above), and it confirmed the
              note this comment used to carry as a warning: surefire's argLine replaces rather
              than appends, so a profile that sets its own <argLine> silently drops the agent.
              The value below therefore reads ${argLine} back instead of replacing it. JaCoCo's
              prepare-agent writes the agent arguments into that property, and the empty default
              in <properties> keeps the expression resolvable when -Djacoco.skip=true is used.
            -->
            <id>surefire-without-container-support</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Maven merges this configuration into the surefire block under
                                 build/plugins (different children, so the systemPropertyVariables
                                 there survive this profile). Runners without full cgroup info used
                                 to crash the test JVM here. -->
                            <argLine>${argLine} -XX:-UseContainerSupport</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

